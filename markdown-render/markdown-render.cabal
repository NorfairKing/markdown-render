license:        AllRightsReserved
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    LICENSE
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/NorfairKing/markdown-render

library
  exposed-modules:
      Markdown.Render
      Markdown.Render.Document
      Markdown.Render.Escapes
      Markdown.Render.Layout
      Markdown.Render.Node
  other-modules:
      Paths_markdown_render
  hs-source-dirs:
      src/
  ghc-options: -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Widentities -Wredundant-constraints -Wcpp-undef -Wunused-packages
  build-depends:
