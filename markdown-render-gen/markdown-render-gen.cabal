source-repository head
  type: git
  location: https://github.com/NorfairKing/markdown-render

library
  exposed-modules:
      Markdown.Render.Gen
  other-modules:
      Paths_markdown_render_gen
  hs-source-dirs:
      src/
  ghc-options: -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Widentities -Wredundant-constraints -Wcpp-undef -Wunused-packages
  build-depends:
      QuickCheck
    , base >=4.7 && <5
    , genvalidity
    , genvalidity-text
    , markdown-render
    , text
  default-language: Haskell2010

test-suite markdown-render-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Markdown.Render.EscapesSpec
      Markdown.RenderSpec
      Paths_markdown_render_gen
  hs-source-dirs:
      test/
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -Wall -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Widentities -Wredundant-constraints -Wcpp-undef -Wunused-packages
  build-tool-depends:
      sydtest-discover:sydtest-discover
  build-depends:
      QuickCheck
    , base >=4.7 && <5
    , bytestring
    , cmark
    , genvalidity-sydtest
    , markdown-render
    , markdown-render-gen
    , sydtest
    , text
  default-language: Haskell2010
